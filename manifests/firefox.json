{
    "manifest_version": 2,
    "name": "Chess.com Blocker",
    "version": "0.0.0",
    "description": "Prevent binging on chess.com. Blocks chess.com if you lose too many games.",
    "permissions": [
        "storage",
        "alarms",
        "https://api.chess.com/*",
        "https://*.chess.com/game*",
        "https://*.chess.com/play/online*"
    ],
    "background": {
        "scripts": ["shared.js", "lossCounter.js", "background.js"],
        "persistent": true
    },
    "content_scripts": [{
        "matches": [
            "https://*.chess.com/game*",
            "https://*.chess.com/play/online*"
        ],
        "js": ["shared.js", "content.js"]
    }],
    "browser_action": {
        "default_icon": "knook.png",
        "default_popup": "options.html"
    },
    "options_ui": {
        "page": "options.html"
    },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "identifier@chessblockerextension.com",
            "strict_min_version": "115.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
