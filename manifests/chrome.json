{
    "manifest_version": 3,
    "minimum_chrome_version": "111",
    "permissions": [
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://api.chess.com/*",
        "https://*.chess.com/game*",
        "https://*.chess.com/play/online*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": "knook.png",
        "default_popup": "options.html"
    }
}
